# ============================================================
# Leechbot / Advanced Channel Recovery Bot — Environment Config
# ============================================================

# --- Telegram API credentials (userbot / MTProto side) ---
# Get these from https://my.telegram.org/apps (login with your own number)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# --- Bot Token (control bot side) ---
# Get this from @BotFather on Telegram: /newbot
BOT_TOKEN=your_bot_token_here

# --- Owner ID ---
# Your personal Telegram numeric user ID (not username).
# Get it from @userinfobot — only this ID can control the bot.
OWNER_ID=your_telegram_user_id

# --- Session String ---
# Leave empty for the very first run, then:
#   node login.js
# Log in with the SAME account whose API_ID/API_HASH you used above,
# copy the printed session string here, save, and restart.
SESSION_STRING=
