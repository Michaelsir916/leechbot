# ==== Userbot (GramJS) credentials ====
# Get these from https://my.telegram.org using the account that is a MEMBER of the source channel
API_ID=123456
API_HASH=your_api_hash_here

# Filled in automatically after you run: node login.js
SESSION_STRING=

# ==== Control bot (Telegraf) ====
# Get this from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user ID (only this user can control the bot)
# Get it from @userinfobot
OWNER_ID=123456789

# ==== Optional: error/log channel ====
# Numeric ID of a private channel/group where the bot is admin, for logging errors.
# Leave empty to disable.
LOG_CHANNEL_ID=
